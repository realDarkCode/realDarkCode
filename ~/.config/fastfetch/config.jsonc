{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "/home/darkcode/.config/fastfetch/logo.txt",
    "width": 18,
    "padding": {
      "right": 4,
      "left": 2,
      "top": 1,
      "bottom": 1,
    },
  },

  "display": {
    "separator": "   ",
    "color": {
      "keys": "cyan",
      "title": "blue",
    },
    "key": {
      "width": 14,
    },
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{#1}@{#}{host-name-colored}",
    },
    {
      "type": "custom",
      "format": "{#90}──────────────────────────────{#}",
    },

    {
      "type": "os",
      "key": "󰣇 OS",
      "format": "{name} ({arch})",
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "format": "{release}",
    },
    {
      "type": "uptime",
      "key": "󱑂 Uptime",
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "format": "{all} (pacman)",
    },

    {
      "type": "custom",
      "format": "{#90}──────────────────────────────{#}",
    },

    {
      "type": "wm",
      "key": "󱂬 WM",
    },
    {
      "type": "terminal",
      "key": "󰞷 Term",
    },
    {
      "type": "shell",
      "key": "󱆃 Shell",
      "format": "{exe-name} {version}",
    },
    {
      "type": "command",
      "key": " Commit",
      "text": "~/.config/fastfetch/scripts/dev-stats.sh gh-commit",
    },
    {
      "type": "command",
      "key": "󱑆 Code",
      "text": "~/.config/fastfetch/scripts/dev-stats.sh waka-stats",
    },
    {
      "type": "display",
      "key": "󰍹 Display",
      "format": "{width}x{height} @ {refresh-rate}Hz",
    },

    {
      "type": "custom",
      "format": "{#90}──────────────────────────────{#}",
    },

    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "format": "{name} ({cores-logical}T)",
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "format": "{name}",
    },
    {
      "type": "memory",
      "key": "󰘚 RAM",
      "format": "{used} / {total} ({percentage})",
    },
    {
      "type": "swap",
      "key": "󰓡 Swap",
      "format": "{used} / {total}",
    },
    {
      "type": "disk",
      "key": "󰋊 Root",
      "folders": ["/"],
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "localip",
      "key": "󰩟 LAN IP",
      "format": "{ipv4}",
    },

    {
      "type": "custom",
      "format": "{#90}──────────────────────────────{#}",
    },

    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
